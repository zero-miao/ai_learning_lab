# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_DATABASE_PATH=backend/db.sqlite3

# LLM Provider
LLM_PROVIDER_TYPE=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.6:35b-a3b

# Optional task-specific model overrides. Any unset task falls back to LLM_MODEL.
# LLM_MODEL_BRIEFING=qwen3:30b-a3b
# LLM_MODEL_ANSWER_QUESTION=qwen3.6:35b-a3b
# LLM_MODEL_CONCEPT_DRAFT=qwen3.6:35b-a3b
# Discussion models are selected from the Topic stage when the task is queued.
LLM_MODEL_DISCUSSION_EXPLORE=qwen2.5:14b
LLM_MODEL_DISCUSSION_FRAME=qwen3:30b-a3b
LLM_MODEL_DISCUSSION_DECIDE=qwen3.6:35b-a3b
# LLM_MODEL_GENERATE_EXAM=qwen3.6:35b-a3b
# LLM_MODEL_GRADE_EXAM=qwen3.6:35b-a3b
# LLM_MODEL_REVIEW_PROMPT=qwen3:30b-a3b
# LLM_MODEL_GRADE_REVIEW=qwen3.6:35b-a3b

# Ollama Models
OLLAMA_CHAT_MODEL=qwen3.6:35b-a3b
OLLAMA_FAST_MODEL=qwen3:30b-a3b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_KEEP_ALIVE=10m

# Local media and V2-alpha services
DJANGO_MEDIA_ROOT=backend/media
ASR_MODEL=small
SEARXNG_BASE_URL=http://127.0.0.1:8080
CRAWL4AI_BASE_URL=http://127.0.0.1:11235
SUPPLEMENT_RELEVANCE_THRESHOLD=0.8
