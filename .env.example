# Django 签名密钥；本地开发也请替换为随机字符串。
DJANGO_SECRET_KEY=change-me
# 是否开启 Django 调试模式。
DJANGO_DEBUG=True
# 允许访问后端的 Host；局域网 IP 可能变化，本地单用户部署使用 *。
DJANGO_ALLOWED_HOSTS=*
# SQLite 数据库路径，相对于项目根目录。
DJANGO_DATABASE_PATH=backend/db.sqlite3
# 媒体文件目录，相对于项目根目录。
DJANGO_MEDIA_ROOT=backend/media
# 单个视频上传大小上限，单位为字节；默认 2 GiB。
MAX_VIDEO_UPLOAD_BYTES=2147483648
# 单个字幕上传大小上限，单位为字节；默认 5 MiB。
MAX_SUBTITLE_UPLOAD_BYTES=5242880

# 以下为系统配置首次初始化的默认值；初始化后请在“系统设置”页面调整。
# LLM 服务类型；当前支持 ollama 或 OpenAI 兼容服务。
LLM_PROVIDER_TYPE=ollama
# OpenAI 兼容接口地址。
LLM_BASE_URL=http://localhost:11434/v1
# 接口密钥；本地 Ollama 可使用固定占位值。
LLM_API_KEY=ollama
# 未单独指定任务模型时使用的默认模型。
LLM_MODEL=qwen3.6:35b-a3b

# 全站管理助手模型。
LLM_MODEL_MANAGEMENT_ASSISTANT=qwen3:30b-a3b
# 话题内学习讨论模型。
LLM_MODEL_TOPIC_CHAT=qwen3:30b-a3b
# 补料检索词生成模型。
LLM_MODEL_SUPPLEMENT_QUERY=qwen3:30b-a3b
# 补料候选相关度评估模型。
LLM_MODEL_SUPPLEMENT_EVALUATE=qwen3.6:35b-a3b
# 材料摘要生成模型。
LLM_MODEL_BRIEFING=qwen3:30b-a3b
# 材料正文清洗与排版模型。
LLM_MODEL_CLEAN_TEXT=qwen3.6:35b-a3b
# 阅读问答模型。
LLM_MODEL_ANSWER_QUESTION=qwen3.6:35b-a3b
# 概念草稿生成模型。
LLM_MODEL_CONCEPT_DRAFT=qwen3.6:35b-a3b
# 掌握度评估出题模型。
LLM_MODEL_GENERATE_EXAM=qwen3.6:35b-a3b
# 掌握度评估阅卷模型。
LLM_MODEL_GRADE_EXAM=qwen3.6:35b-a3b
# 复习提示生成模型。
LLM_MODEL_REVIEW_PROMPT=qwen3:30b-a3b
# 复盘反馈评分模型。
LLM_MODEL_GRADE_REVIEW=qwen3.6:35b-a3b

# 模型在 Ollama 内存中的空闲保留时间。
OLLAMA_KEEP_ALIVE=2m

# 无字幕视频使用的 faster-whisper 模型。
ASR_MODEL=small
# Edge TTS 音色，多个值使用英文逗号分隔；可用“音色|显示名”设置中文标签。
TTS_VOICES=zh-CN-XiaoxiaoNeural|晓晓,zh-CN-YunxiNeural|云希
# SearxNG 本地检索服务地址。
SEARXNG_BASE_URL=http://127.0.0.1:8080
# 补料候选最低相关度，取值范围为 0 到 1。
SUPPLEMENT_RELEVANCE_THRESHOLD=0.85
# 补料检索排除域名，英文逗号分隔，自动包含其子域名
SUPPLEMENT_EXCLUDED_DOMAINS=wikipedia.org,weread.qq.com,douban.com,dedao.cn
# 阅读页默认音色与语速；设备上最后一次选择会覆盖默认值
DEFAULT_TTS_VOICE=zh-CN-YunxiNeural
DEFAULT_SPEECH_RATE=1.5

# 前端访问后端 API 的基础地址，必须以 / 结尾；同源路径支持局域网设备访问。
VITE_API_BASE_URL=/api/
# 前端启动阶段的请求超时，系统配置加载后使用数据库中的设置，单位为毫秒。
VITE_API_TIMEOUT_MS=10000
# 首次访问时的全局背景主题；可选 paper、sepia、green、gray、dark、midnight、charcoal、coffee。
VITE_DEFAULT_SITE_THEME=paper
# 首次进入学习页时的正文字体；可选 system、song、kai、serif。
VITE_DEFAULT_READER_FONT=system
