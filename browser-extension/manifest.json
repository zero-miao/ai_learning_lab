{
  "manifest_version": 3,
  "name": "AI Learning Lab 页面采集器",
  "version": "0.1.0",
  "description": "将当前浏览器页面采集到本机 AI Learning Lab。",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "采集当前页"
  },
  "background": {
    "service_worker": "assets/service-worker.js",
    "type": "module"
  }
}
